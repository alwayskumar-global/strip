{
  "name": "strip-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm test:tools",
    "test:tools": "vitest run --root tools",
    "dev": "pnpm --filter @strip/app dev",
    "build": "pnpm --filter @strip/app build",
    "build:gallery": "pnpm --filter @strip/app build:gallery",
    "test:fidelity": "pnpm --filter @strip/app test:fidelity",
    "test:e2e": "pnpm --filter @strip/app test:e2e",
    "purity": "node .kiro/hooks/scripts/purity.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
