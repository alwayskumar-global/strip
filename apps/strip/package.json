{
  "name": "@strip/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:gallery": "vite build --mode gallery",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test --project=harness --project=gallery --project=app --project=camera",
    "test:fidelity": "playwright test --project=fidelity-baseline --project=fidelity"
  },
  "dependencies": {
    "@strip/codec": "workspace:*",
    "@strip/symbols": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
